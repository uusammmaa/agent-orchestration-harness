# ---------------------------------------------------------------------------
# Every value is optional. With none of them set the harness runs on an
# in-memory store, a stub Odoo and a rules brain, and says so at /health.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Unset: in-memory, which is fine for the console demo and the tests, and wrong
# for anything you care about. Set: Postgres, migrated automatically on boot.
DATABASE_URL=postgres://harness:harness@localhost:5432/harness
# Hosted Postgres with a self-signed certificate.
DATABASE_SSL=

# --- Odoo ------------------------------------------------------------------
# An API key rather than a password: Settings -> Users -> Account Security.
# Unset: the stub Odoo, seeded with a small realistic company.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database
ODOO_USERNAME=automation@your-company.com
ODOO_API_KEY=

# --- Agents ----------------------------------------------------------------
# Unset: the rules brain, which implements the same contract and costs nothing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Process ---------------------------------------------------------------
# api | worker | all
ROLE=all
PORT=3000
WORKER_CONCURRENCY=4
# Short, because heartbeats extend it while a handler is working. Short leases
# are what make crash recovery fast.
WORKER_LEASE_MS=30000
WORKER_POLL_MS=500
DISPATCH_INTERVAL_MS=1000
