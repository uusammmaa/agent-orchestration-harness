{
  "name": "agent-orchestration-harness",
  "version": "1.0.0",
  "private": true,
  "description": "A durable, approval-gated orchestration backend that coordinates LLM agents for accounts-receivable collections and lead follow-up, integrated with Odoo ERP.",
  "license": "MIT",
  "engines": { "node": ">=20.9.0" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pg": "HARNESS_TEST_POSTGRES=1 vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "tsx packages/core/src/store/migrate-cli.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:console": "npm run dev --workspace @harness/console",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
